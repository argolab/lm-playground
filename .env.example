# Copy to .env and uncomment what you need. Every line is optional.

# Key for the hosted models in models.json. Without it, each visitor pastes their own key in the page.
# OPENROUTER_API_KEY=

# Only for downloading and serving models on your own GPU.
# Hugging Face token, needed for repositories that ask you to accept a license.
# HF_TOKEN=
# Folder the model weights are downloaded to and loaded from.
# HF_HUB_CACHE=
